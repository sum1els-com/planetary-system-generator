<h5>{{name}}</h5>
<div class="row">
    <div class="col s7">
        <div class="row"><div class="col s4 bold">Class:</div><div class="col s6 class">{{className}}, {{classification}}</div></div>
        <div class="row"><div class="col s4 bold">Age:</div><div class="col s6 age">{{formatNumber age}} <span class="tooltipped" data-position="right" data-tooltip="Billion Years">Byr</span></div></div>
        <div class="row"><div class="col s4 bold">Diameter: </div><div class="col s6 diameter">{{formatNumber diameter}} <span class="tooltipped" data-position="right" data-tooltip="Kilometers">km</span></div></div>
        <div class="row"><div class="col s4 bold">Planetary Radius: </div><div class="col s6 planetaryRadius">{{formatNumber planetaryRadius}} <span class="tooltipped" data-position="right" data-tooltip="Earth Radii">R<sub>⊕</sub></span></div></div>
        <div class="row"><div class="col s4 bold">Composition:</div><div class="col s6 density">{{density.name}}</div></div>
        <div class="row"><div class="col s4 bold">Mass:</div><div class="col s6 mass">{{formatNumber mass}} <span class="tooltipped" data-position="right" data-tooltip="Earth Masses">M<sub>⊕</sub></span></div></div>
        <div class="row"><div class="col s4 bold">Distance:</div><div class="col s6 distance">{{distance.name}}, {{distance.value}} <span class="tooltipped" data-position="right" data-tooltip="Earth Radii">R<sub>⊕</sub></span>, {{formatNumber distance.valueKm}} <span class="tooltipped" data-position="right" data-tooltip="Kilometers">km</span></div></div>
        <div class="row"><div class="col s4 bold">Gravity:</div><div class="col s6 gravity">{{formatNumber gravity}} <span class="tooltipped" data-position="right" data-tooltip="Standard Gravity">g</span></div></div>
        <div class="row"><div class="col s4 bold">Orbit:</div><div class="col s6 orbit">{{orbit.type}}</div></div>
        <div class="row"><div class="col s4 bold">Inclination:</div><div class="col s6 inclination">{{inclination.type}}{{#if inclination.value}}, {{inclination.value}}&deg;{{/if}}</div></div>
        <div class="row"><div class="col s4 bold">Orbital Period:</div><div class="col s6 star-mass">Tidally Locked, {{formatNumber orbitalPeriod}} <span class="tooltipped" data-position="right" data-tooltip="Earth Days">day(s)</span></div></div>
        <div class="row"><div class="col s4 bold">Axial Tilt:</div><div class="col s6">{{axialTilt.name}}, {{axialTilt.value}}&deg;</div></div>
        <div class="row"><div class="col s4 bold">Day Length:</div><div class="col s6">{{formatNumber dayLength}} <span class="tooltipped" data-position="right" data-tooltip="Hours">hours</span></div></div>
        <div class="row"><div class="col s4 bold">Atmosphere:</div><div class="col s6 atmosphere">{{atmosphere.name}}, {{atmosphere.density}} <span class="tooltipped" data-position="right" data-tooltip="Earth Atmospheric Density">D<sub>⊕</sub></span></div></div>
        {{#each atmosphericComposition.components}}
        <div class="row"><div class="col s2 bold"></div><div class="col s4">{{name}}</div><div class="col s2">{{value}}%</div></div>
        {{/each}}
        <div class="row"><div class="col s4 bold">Hydrosphere:</div><div class="col s6">{{hydrosphere.name}}</div></div>
        <div class="row"><div class="col s4 bold">Weather:</div><div class="col s6">{{weather}}</div></div>
        <div class="row"><div class="col s4 bold">Temperature:</div><div class="col s6">{{#if temperature.name}}{{temperature.name}}, {{/if}}{{formatNumber temperature.celsius}}<span class="tooltipped" data-position="right" data-tooltip="Degrees Celsius">&deg;C</span> / {{formatNumber temperature.fahrenheit}}<span class="tooltipped" data-position="right" data-tooltip="Degrees Fahrenheit">&deg;F</span></div></div>
        <div class="row"><div class="col s4 bold">Tectonic Activity:</div><div class="col s6">{{tectonicActivity}}</div></div>
        <div class="row"><div class="col s4 bold">Life:</div><div class="col s6">{{life.name}}</div></div>
    </div>
    <div class="col s5">
        <div class="right image-frame starfield-bg"><img class="right responsive-img" src="{{image}}"></div>
    </div>
</div>
<div class="row no-margin info-container"><div class="col s2 bold">Info:</div></div>
<div class="row no-margin"><div class="col s11 star-info">{{{info}}}</div></div>
