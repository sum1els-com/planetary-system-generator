<div><span class="bold">Orbital Separation: </span>Distance between stellar groups.</div>
<div><span class="bold">Stellar Separation: </span>Distance between other stars in stellar group.</div>
<table class="highlight">
    <thead>
        <tr>
            <th>Group Name</th>
            <th>Star Name</th>
            <th>Luminosity</th>
            <th>Mass</th>
            <th>Orbital Separation</th>
            <th>Stellar Separation</th>
        </tr>
    </thead>
    <tbody>
        {{#each starGroup}}
        {{#each stars}}
        <tr>
            <td><a class="object-link" data-name="{{../name}}">{{../name}}</a></td>
            <td><a class="object-link" data-name="{{name}}">{{name}}</a></td>
            <td>{{formatNumber ../luminosity}} <span class="tooltipped" data-position="right" data-tooltip="Solar Luminosity">L<sub>☉</sub></span></td>
            <td>{{formatNumber ../mass}} <span class="tooltipped" data-position="right" data-tooltip="Solar Mass">M<sub>☉</sub></span></td>
            <td>{{formatNumber orbitalSeparation.distance}} <span class="tooltipped" data-position="right" data-tooltip="Astronomical Units">au</span></td>
            <td>{{formatNumber ../stellarSeparation}} <span class="tooltipped" data-position="right" data-tooltip="Astronomical Units">au</span></td>
        </tr>
        {{/each}}
        {{/each}}
    </tbody>
</table>
